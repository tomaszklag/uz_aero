{
  "name": "@uzaero/server",
  "version": "0.0.0",
  "private": true,
  "description": "UZ Aero — backend: przyjmowanie zdarzeń, scalanie sesji, flagi, eksport do Sheets",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "seed": "tsx --env-file-if-exists=.env src/bin/seedCli.ts",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seedDemo.ts",
    "db:demo": "tsx --env-file-if-exists=.env scripts/bootstrapDemoDb.ts",
    "rebuild-projections": "tsx --env-file-if-exists=.env src/bin/rebuildProjectionsCli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@uzaero/domain": "*",
    "@uzaero/format": "*",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "vitest": "^2.1.8"
  }
}
