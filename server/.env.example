# UZ Aero (serwer) — konfiguracja środowiska.
# Skopiuj do `.env` (npm run setup robi to za Ciebie) i uzupełnij wartości.
# `.env` jest w .gitignore — sekrety nie trafiają do repozytorium.

# Połączenie z Postgresem (docker: npm run db:up w katalogu głównym)
DATABASE_URL=postgres://postgres:dev@localhost:5432/uzaero

# Sekret podpisu JWT — minimum 32 znaki; na produkcji wygeneruj losowy
JWT_SECRET=dev-secret-min-32-znaki-dluga-fraza

# Port HTTP (domyślnie 3000)
PORT=3000

# Hasło startowe kont z seeda (tylko dla `npm run seed`)
SEED_PASSWORD=test1234

# Eksport do Google Sheets (§4.7) — konto serwisowe backendu; telefon nie dotyka Sheets.
# Bez poniższych wartości eksport jest WYŁĄCZONY (adapter Google powstanie razem
# z kluczem serwisowym; port, eksporter i dziennik export_log już czekają w kodzie).
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}
# SHEETS_SPREADSHEET_ID=1AbC...
