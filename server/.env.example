# UZ Aero (serwer) - konfiguracja środowiska.
# Skopiuj do `.env` (npm run setup robi to za Ciebie) i uzupełnij wartości.
# `.env` jest w .gitignore - sekrety nie trafiają do repozytorium.

# Połączenie z Postgresem (docker: npm run db:up w katalogu głównym)
DATABASE_URL=postgres://postgres:dev@localhost:5432/uzaero

# Sekret podpisu JWT - minimum 32 znaki; na produkcji wygeneruj losowy
JWT_SECRET=dev-secret-min-32-znaki-dluga-fraza

# Port HTTP (domyślnie 3000)
PORT=3000

# NASZE identyfikatory klienta Google (od 2026-09-04 - hasła zniknęły z produktu,
# patrz docs/logowanie-google.md). To jest kontrola oddzielająca „ktoś zalogował się
# do UZ Aero" od „ktoś ma dowolny token Google" (`aud` w weryfikacji tokenu).
# WEB jest WYMAGANY - loguje się nim panel i to on jedzie do przycisku logowania;
# ANDROID jest opcjonalny do czasu builda aplikacji pilota z Google.
GOOGLE_WEB_CLIENT_ID=000000000000-web.apps.googleusercontent.com
# GOOGLE_ANDROID_CLIENT_ID=000000000000-android.apps.googleusercontent.com

# ADRES KONTA GOOGLE administratora. Czyta go `npm run seed`, a gdy jest ustawiony na
# serwerze - także start serwera (bootstrap na hostingu). Konto `admin` powstaje BEZ
# hasła, a pierwsze logowanie kontem Google o tym adresie je PODPINA - i to jest cały
# mechanizm wejścia do panelu po wdrożeniu (docs/logowanie-google.md §6).
SEED_ADMIN_EMAIL=admin@example.com

# Eksport dziennych kart (§4.7) jest WŁĄCZONY - karty lądują w tabeli exported_sheets
# (bazodanowy adapter SheetsPort) i są serwowane pod GET /sheets/:tab.
# PUBLIC_BASE_URL = adres serwera widziany Z TELEFONU (baza linków do kart na ekranie 11);
# bez niego linki wskazują localhost - dobre na dev przy komputerze, złe w terenie.
# PUBLIC_BASE_URL=http://192.168.1.20:3000

# Ślad kalibracyjny GPS (faza 5) - telefony zrzucają surowe fixy na POST /traces;
# NDJSON per sesja do analizy progów (skrypt: npx tsx scripts/replay.ts <plik>).
# TRACES_DIR=./traces

# Hosting (produkcja; dev tej zmiennej NIE ustawia - patrz README „Wdrożenie"):
# TRUST_PROXY=1 gdy serwer stoi ZA proxy TLS (Railway itp.) - bez tego dziennik
#   audytu zapisuje adres proxy zamiast człowieka. Build panelu serwer serwuje
#   spod wbudowanej ścieżki `admin/dist` (zmiennej nie ma); w dev panel jedzie
#   z Vite (npm run admin).
# TRUST_PROXY=1

# Google Sheets - PRZYSZŁA podmiana bazodanowego adaptera (ten sam port SheetsPort,
# jedno miejsce w composition root). Wymaga klucza konta serwisowego; do tego czasu
# poniższe zmienne są nieużywane.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}
# SHEETS_SPREADSHEET_ID=1AbC...
