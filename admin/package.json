  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
