{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "production": {
      "channel": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://app.ninerdeck.pl",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "153560452565-agg2pcjh9loqa8o6h047009okml3lq7f.apps.googleusercontent.com"
      }
    }
  }
}
