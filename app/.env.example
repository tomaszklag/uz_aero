# Ninerdeck (aplikacja pilota) - konfiguracja środowiska.
# Skopiuj do `app/.env` (jest w .gitignore). Expo wczytuje ten plik przy starcie Metro
# i wkleja zmienne `EXPO_PUBLIC_*` do bundla - są STAŁYMI tej wersji aplikacji.

# TEN PLIK DOTYCZY WYŁĄCZNIE DEV (Metro). Build EAS i aktualizacja OTA biorą zmienne
# z `eas.json` → build.<profil>.env: build czyta je sam, a runner `scripts/eas-update.js`
# wstrzykuje profil do `eas update`, które tego pola nie zna - `npm run update:prod`
# profil production (piloci), `npm run update:stg` profil development (staging,
# docs/staging.md). Wartość stąd nie ma jak trafić do telefonów pilotów - i tak ma być.

# WARIANT konfiguracji Expo (`app.config.js` → `scripts/app-variant.js`): `development`
# przestawia nazwę na „Ninerdeck Dev", a pakiet na `com.ninerdeck.app.dev`, żeby dev build
# (`npm run build:dev`) stał na telefonie OBOK produkcyjnego APK. Metro i `expo run:android`
# czytają zmienną stąd; buildy EAS - z `eas.json`. Każda inna wartość znaczy produkcję.
APP_VARIANT=development

# Identyfikator klienta Google typu ANDROID dla DEV BUILDA (docs/logowanie-google.md §12):
# package `com.ninerdeck.app.dev` + odcisk SHA-1 klucza EAS TEGO pakietu (poświadczenia
# EAS są per pakiet, więc to inny klucz i inny klient niż produkcyjny z `eas.json`).
# Ten sam identyfikator wpisz w `server/.env` jako GOOGLE_ANDROID_CLIENT_ID - lokalny
# serwer musi go przyjąć jako odbiorcę tokenu. Bez niego przycisk „Kontynuuj z Google"
# mówi, że ta wersja aplikacji nie ma skonfigurowanego logowania.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Adres serwera - w dev zwykle NIEUSTAWIONY: telefon rozmawia z komputerem, na którym
# stoi Metro, pod tym samym IP na :3000 (patrz `src/infrastructure/api/apiBaseUrl.ts`).
# Produkcja: https://app.ninerdeck.pl (panel i API; strona stoi pod https://ninerdeck.pl).
# Staging: https://app.stg.ninerdeck.pl - tak wskazuje się dev build na próbę generalną
# wydania przy biurku (bez Metro robi to `npm run update:stg`; docs/staging.md §5).
# EXPO_PUBLIC_API_URL=https://app.ninerdeck.pl
