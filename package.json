{
  "name": "uzaero",
  "private": true,
  "version": "0.0.0",
  "description": "UZ Aero — elektroniczny chronometraż lotów: aplikacja (Expo) + serwer (Fastify) + wspólna domena",
  "workspaces": [
    "app",
    "server",
    "packages/*"
  ],
  "scripts": {
    "app": "npm run start --workspace app",
    "android": "npm run android --workspace app",
    "server": "npm run dev --workspace server",
    "seed": "npm run seed --workspace server",
    "setup": "node -e \"const f=require('fs');if(!f.existsSync('server/.env'))f.copyFileSync('server/.env.example','server/.env')\" && npm install",
    "db:up": "docker start uzaero-pg || docker run --name uzaero-pg -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=uzaero -p 5432:5432 -d postgres:16",
    "db:down": "docker stop uzaero-pg",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
