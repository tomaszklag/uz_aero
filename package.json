{
  "name": "ninerdeck",
  "private": true,
  "version": "0.0.0",
  "description": "Ninerdeck - elektroniczny chronometraż lotów: aplikacja (Expo) + serwer (Fastify) + wspólna domena",
  "workspaces": [
    "app",
    "admin",
    "server",
    "packages/*"
  ],
  "scripts": {
    "app": "npm run start --workspace app",
    "android": "npm run android --workspace app",
    "build:dev": "npm run build:dev --workspace app",
    "build:prod": "npm run build:prod --workspace app",
    "update:prod": "npm run update:prod --workspace app",
    "server": "npm run dev --workspace server",
    "admin": "npm run dev --workspace admin",
    "site": "node site/tools/build.mjs",
    "seed": "npm run seed --workspace server",
    "setup": "node -e \"const f=require('fs');if(!f.existsSync('server/.env'))f.copyFileSync('server/.env.example','server/.env')\" && npm install",
    "db:up": "docker start ninerdeck-pg || docker run --name ninerdeck-pg -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=ninerdeck -p 5432:5432 -d postgres:16",
    "db:down": "docker stop ninerdeck-pg",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/react": "~19.1.10"
  }
}
